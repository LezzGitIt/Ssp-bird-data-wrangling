# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Ignore files with the following extensions
*.tar.gz
*.kmz
*.kml
*.shp
*.tif
*.xlsx
*.DS_Store
*.pdf

# Recreatable / raw folders — not tracked
Data/
Rdata/
Derived/
Simulating_data_Claire/

# Figures/ is regenerated; only Figures/Static/ (the figures no script rebuilds
# from a bare clone) is tracked
Figures/*
!Figures/Static

# Data-paper supporting material kept local (not part of the DataS1 deposit)
Suppfiles/style-guide/
Docs/

# DataS1/ is the deposit and IS tracked, but *.xlsx is ignored globally above:
!DataS1/Column_definitions_final.xlsx

# Quarto / LaTeX render byproducts, scoped to Scripts/qmd/ so they can never
# shadow real sources (Suppfiles/title.tex, _extensions/**)
Scripts/qmd/*_files/
Scripts/qmd/*_cache/
Scripts/qmd/*.tex
Scripts/qmd/*.aux
Scripts/qmd/*.bbl
Scripts/qmd/*.blg
Scripts/qmd/*.log
Scripts/qmd/*.toc
Scripts/qmd/*.out
Scripts/qmd/*.spl
Scripts/qmd/*.rmarkdown
Scripts/qmd/*.pdf
Scripts/qmd/*.docx
Scripts/qmd/*.cls
Scripts/qmd/*.bst

# Working docs (session notes / migration plan, not the science)
Project_notes.md
Migration_plan.md

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

/.quarto/
