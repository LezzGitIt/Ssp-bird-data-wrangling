# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Ignore files with the following extensions
*.tar.gz
*.kmz
*.kml
*.shp
*.tif
*.xlsx
*.DS_Store
*.pdf

# Recreatable / raw folders — not tracked
Data/
Rdata/
Derived/
Simulating_data_Claire/

# Figures/ is regenerated; only Figures/Static/ (the figures no script rebuilds
# from a bare clone) is tracked
Figures/*
!Figures/Static

# Data-paper supporting material kept local (not part of the DataS1 deposit)
Suppfiles/style-guide/
Docs/

# DataS1/ is the deposit and IS tracked, but *.xlsx is ignored globally above:
!DataS1/Column_definitions_final.xlsx

# Elsevier Quarto format — vendored third-party machinery, restored on any machine with
# `quarto add quarto-journals/elsevier` (see README); re-bundled into the deposit at Zenodo time
/_extensions/

# Quarto / LaTeX render byproducts, scoped to Scripts/Data_paper/qmd/ so they can never
# shadow the real tracked Suppfiles/title.tex
Scripts/Data_paper/qmd/*_files/
Scripts/Data_paper/qmd/*_cache/
Scripts/Data_paper/qmd/*.tex
Scripts/Data_paper/qmd/*.aux
Scripts/Data_paper/qmd/*.bbl
Scripts/Data_paper/qmd/*.blg
Scripts/Data_paper/qmd/*.log
Scripts/Data_paper/qmd/*.toc
Scripts/Data_paper/qmd/*.out
Scripts/Data_paper/qmd/*.spl
Scripts/Data_paper/qmd/*.rmarkdown
Scripts/Data_paper/qmd/*.pdf
Scripts/Data_paper/qmd/*.docx
Scripts/Data_paper/qmd/*.cls
Scripts/Data_paper/qmd/*.bst

# Working docs (session notes / migration plan, not the science)
Project_notes.md
Migration_plan.md

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

/.quarto/
