  file = {/Users/aaronskinner/Desktop/Grad_School/Zotero/storage/W9AZPZGQ/DeClerck et al. - 2010 - Biodiversity conservation in human-modified landsc.pdf}
}

@article{desrochersGapCrossingDecisions1997,
  title = {Gap {{Crossing Decisions}} by {{Forest Songbirds}} during the {{Post-Fledging Period}}. {{Decisiones}} de {{Cruce}} de {{Claros}} Por {{Aves Paserinas}} de {{Bosques Durante}} El {{Periodo Post-Juvenil}}},
