  title = {The {{Economics}} and {{Ecology}} of {{Shade-grown Coffee}}: {{A Model}} to {{Incentivize Shade}} and {{Bird Conservation}}},
  shorttitle = {The {{Economics}} and {{Ecology}} of {{Shade-grown Coffee}}},
